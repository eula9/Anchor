<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ 云备份与设备迁移规则。
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/anchor_preferences.preferences_pb" />
        <include domain="database" path="anchor_database" />
        <include domain="database" path="anchor_database-shm" />
        <include domain="database" path="anchor_database-wal" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/anchor_preferences.preferences_pb" />
        <include domain="database" path="anchor_database" />
        <include domain="database" path="anchor_database-shm" />
        <include domain="database" path="anchor_database-wal" />
    </device-transfer>
</data-extraction-rules>
